// Impasto's starter Niri configuration.
// Existing user configurations are preserved by setup; merge these nodes
// manually if you already have ~/.config/niri/config.kdl.

spawn-at-startup "qs" "-d"
spawn-at-startup "kanshi"

layout {
    gaps 14
    border {
        off
    }
    focus-ring {
        off
    }
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
}

binds {
    Mod+Space { spawn "qs" "ipc" "call" "panel" "open" "launcher"; }
    Mod+Shift+Space { spawn "qs" "ipc" "call" "panel" "open" "controls"; }
    Mod+Shift+Tab { spawn "qs" "ipc" "call" "panel" "open" "overview"; }
    Mod+Comma { spawn "qs" "ipc" "call" "panel" "open" "keys"; }
    Mod+Shift+A { spawn "qs" "ipc" "call" "panel" "open" "appearance"; }
    Mod+Shift+N { spawn "qs" "ipc" "call" "panel" "open" "notes"; }
    Mod+Shift+B { spawn "qs" "ipc" "call" "panel" "open" "board"; }
    Mod+Shift+G { spawn "qs" "ipc" "call" "panel" "open" "games"; }
    Mod+Shift+S { spawn "qs" "ipc" "call" "panel" "open" "session"; }
    Mod+Shift+W { spawn "qs" "ipc" "call" "widgets" "toggle"; }
    Mod+Shift+O { spawn "qs" "ipc" "call" "settings" "toggle"; }
    Mod+Shift+X { spawn "qs" "ipc" "call" "picker" "pick"; }
    Mod+Shift+R { spawn "qs" "ipc" "call" "capture" "open" "region" "editor"; }
    Mod+Shift+C { spawn "qs" "ipc" "call" "launcher" "mode" "clipboard"; }
    Mod+Shift+Alt+E { spawn "qs" "ipc" "call" "launcher" "mode" "emoji"; }
    Mod+Shift+M { spawn "qs" "ipc" "call" "nightlight" "set" "toggle"; }
    Mod+Shift+Up { spawn "qs" "ipc" "call" "brightness" "step" "5"; }
    Mod+Shift+Down { spawn "qs" "ipc" "call" "brightness" "step" "-5"; }
    Mod+Shift+F12 { spawn "qs" "ipc" "call" "recorder" "toggle"; }
    Mod+Shift+P { power-off-monitors; }

    Mod+Q { close-window; }
    Mod+Shift+E { quit; }
    Mod+Shift+L { spawn "qs" "ipc" "call" "lock" "lock"; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+A { toggle-window-floating; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
}

// Put personal overrides in separate files and add an include here if desired.
// include "config.d/*.kdl"
