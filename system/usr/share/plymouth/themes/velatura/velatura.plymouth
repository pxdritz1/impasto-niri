[Plymouth Theme]
Name=velatura
Description=The palette, painted while the machine starts
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/velatura
ScriptFile=/usr/share/plymouth/themes/velatura/velatura.script
